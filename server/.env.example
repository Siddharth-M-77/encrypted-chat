NODE_ENV=development
PORT=4000

# Public URL of the frontend (used for CORS). No trailing slash.
FRONTEND_URL=http://localhost:5173
# Host (and port, if any) the frontend is served from. Must equal the SIWE "domain" the browser signs.
SIWE_DOMAIN=localhost:5173
# Comma-separated list of chain IDs accepted at sign-in (56 = BSC mainnet, 97 = BSC testnet).
ALLOWED_CHAIN_IDS=97,56

MONGO_URI=mongodb://127.0.0.1:27017/mtalk
REDIS_URL=redis://127.0.0.1:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=7

# Must match static-auth-secret in docker/coturn/turnserver.conf (used from Phase 6)
TURN_SECRET=change-me-turn-secret
TURN_URL=turn:localhost:3478
STUN_URL=stun:localhost:3478

UPLOAD_DIR=./uploads
