# Backend is reached through the Vite dev proxy (see vite.config.js), so no API URL is needed in dev.
# In production Nginx serves both on the same origin.

# Chain used for sign-in: 97 = BSC testnet, 56 = BSC mainnet
VITE_CHAIN_ID=97
# Optional: get a project ID at https://dashboard.reown.com to enable WalletConnect. Leave empty for MetaMask only.
VITE_WALLETCONNECT_PROJECT_ID=
# Proxy target for local dev
VITE_DEV_API_TARGET=http://localhost:4000
